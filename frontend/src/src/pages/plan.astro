---
import Layout from '../layouts/Layout.astro';

const bg      = "#070C18";
const surface = "#0D1321";
const card    = "#111827";
const border  = "#1E2A3B";
const muted   = "#5B6B7D";
const dim     = "#94A3B8";
const textColor = "#E2E8F0";
const green   = "#00FFA3";
const blue    = "#38BDF8";
const yellow  = "#FBBF24";
const red     = "#F87171";
const purple  = "#A78BFA";
const orange  = "#FB923C";

// ── All stacks, combined, one source of truth ─────────────────────────────
const stacks = [
  {
    cat: "DSA", icon: "🧮", color: green,
    items: [
      { skill: "Arrays, Strings, Two Pointer",   tw:3, ms:3, de:2, wk:"W1–2"  },
      { skill: "Linked Lists, Stack, Queue",      tw:2, ms:3, de:2, wk:"W2–3"  },
      { skill: "Binary Search",                   tw:3, ms:3, de:2, wk:"W3"    },
      { skill: "Trees & BST (DFS/BFS)",           tw:3, ms:3, de:2, wk:"W3–4"  },
      { skill: "Graphs (BFS/DFS/topological)",    tw:3, ms:3, de:2, wk:"W4–6"  },
      { skill: "Sliding Window / Prefix Sum",     tw:3, ms:3, de:2, wk:"W2–3"  },
      { skill: "Heap / Priority Queue",           tw:2, ms:3, de:2, wk:"W5–6"  },
      { skill: "Dynamic Programming",             tw:2, ms:3, de:2, wk:"W6–10" },
      { skill: "Union-Find, Dijkstra",            tw:1, ms:3, de:2, wk:"W11"   },
    ],
  },
  {
    cat: ".NET / C#", icon: "⚙️", color: blue,
    items: [
      { skill: "SOLID + Clean Architecture",      tw:3, ms:3, de:3, wk:"W1"    },
      { skill: "DI, Middleware (ASP.NET Core)",   tw:2, ms:3, de:2, wk:"W2–3"  },
      { skill: "async/await & Task internals",    tw:2, ms:3, de:2, wk:"W3–4"  },
      { skill: "LINQ internals & IQueryable",     tw:2, ms:3, de:2, wk:"W4"    },
      { skill: "Entity Framework Core + SQL",     tw:2, ms:3, de:3, wk:"W5–6"  },
      { skill: "GC, Span<T>, memory model",       tw:1, ms:3, de:2, wk:"W9–10" },
      { skill: "CLR, JIT, async state machine",   tw:1, ms:3, de:2, wk:"W15"   },
      { skill: "Minimal API + Blazor basics",     tw:1, ms:2, de:2, wk:"W13"   },
    ],
  },
  {
    cat: "TDD & Clean Code", icon: "🧪", color: green,
    items: [
      { skill: "Red-Green-Refactor cycle",        tw:3, ms:2, de:2, wk:"W1"    },
      { skill: "TDD Katas (FizzBuzz → String Calc → Roman)", tw:3, ms:2, de:2, wk:"W1–6" },
      { skill: "Test doubles (mock/stub/fake/spy)",tw:3, ms:2, de:2, wk:"W2–3"  },
      { skill: "xUnit + FluentAssertions",        tw:2, ms:3, de:2, wk:"W2"    },
      { skill: "Pair programming etiquette",      tw:3, ms:1, de:1, wk:"W3–8"  },
      { skill: "Mutation testing (Stryker)",      tw:2, ms:1, de:1, wk:"W7"    },
    ],
  },
  {
    cat: "System Design", icon: "🏛️", color: purple,
    items: [
      { skill: "REST API design (contracts, versioning)", tw:3, ms:3, de:3, wk:"W3"    },
      { skill: "C4 model diagrams (L1–L3)",       tw:3, ms:3, de:2, wk:"W4–5"  },
      { skill: "LLD: OOP design problems",        tw:3, ms:3, de:2, wk:"W4–7"  },
      { skill: "SQL design, indexes, EXPLAIN",    tw:3, ms:3, de:3, wk:"W5–7"  },
      { skill: "HLD: scale to 1M users",          tw:2, ms:3, de:2, wk:"W9–12" },
      { skill: "Caching (Redis, CDN patterns)",   tw:2, ms:3, de:2, wk:"W9–10" },
      { skill: "Message queues & event-driven",   tw:2, ms:3, de:2, wk:"W10–12"},
      { skill: "CAP theorem & real tradeoffs",    tw:2, ms:3, de:2, wk:"W11"   },
    ],
  },
  {
    cat: "Azure & Cloud", icon: "☁️", color: blue,
    items: [
      { skill: "Azure App Service (deploy + slots)",  tw:1, ms:3, de:2, wk:"W7–8"  },
      { skill: "Azure Functions (triggers × 5)",  tw:1, ms:3, de:2, wk:"W11–12"},
      { skill: "Cosmos DB (partition key, RU, change feed)", tw:1, ms:3, de:2, wk:"W10–11"},
      { skill: "Azure Service Bus (queues, topics, DLQ)",    tw:1, ms:3, de:2, wk:"W10–11"},
      { skill: "GitHub Actions CI/CD pipeline",   tw:2, ms:2, de:2, wk:"W7–8"  },
      { skill: "Key Vault + managed identity",    tw:1, ms:3, de:2, wk:"W12–13"},
      { skill: "OpenTelemetry SDK + Azure Monitor",tw:1, ms:3, de:2, wk:"W13"   },
      { skill: "AZ-204 Certification",            tw:0, ms:3, de:2, wk:"W14–16"},
    ],
  },
  {
    cat: "Angular", icon: "🅰️", color: red,
    items: [
      { skill: "Components, modules, DI",         tw:2, ms:2, de:2, wk:"W2–3"  },
      { skill: "RxJS core operators",             tw:2, ms:2, de:2, wk:"W5–6"  },
      { skill: "Reactive forms + validation",     tw:2, ms:1, de:2, wk:"W6–7"  },
      { skill: "HTTP client + interceptors",      tw:2, ms:1, de:2, wk:"W7"    },
      { skill: "NgRx state management",           tw:1, ms:2, de:2, wk:"W13–15"},
    ],
  },
  {
    cat: "Behavioral & Soft", icon: "🎤", color: yellow,
    items: [
      { skill: "STAR method (6 core stories)",    tw:3, ms:3, de:3, wk:"W4–8"  },
      { skill: "Social cause story (TW-specific)",tw:3, ms:1, de:1, wk:"W5–6"  },
      { skill: "Salary negotiation script",       tw:2, ms:2, de:2, wk:"W7–8"  },
      { skill: "German A1 → A2",                  tw:0, ms:0, de:3, wk:"W1–24 (daily)" },
    ],
  },
];

// ── 24-week master path ───────────────────────────────────────────────────
const phases = [
  {
    n:"1", label:"TW-READY", weeks:"Week 1–8", color: green, icon:"🧪",
    unlock:"ThoughtWorks application → apply end of Week 8",
    goal:"TDD daily. 50 LeetCode. 6 STAR stories. Ship a live full-stack showcase.",
    plan: [
      { w:"W1", focus:"Foundations",        tasks:["SOLID + Clean Architecture (read + apply)", "TDD: FizzBuzz kata (daily)", "DSA: Arrays, Two Pointer, Sliding Window (10 problems)", "German: Duolingo start — streak #1", "Setup: repo + CI + Azure App Service live"] },
      { w:"W2", focus:"Core Patterns",      tasks:["TDD: String Calculator kata", "DSA: Linked List, Stack, Queue, Binary Search (10)", "Angular: components + modules + DI", ".NET: DI container + middleware pipeline", "Ship: 'Hello World' API live on Azure with passing tests"] },
      { w:"W3", focus:"Trees + API Design", tasks:["DSA: Binary Trees, BFS/DFS, recursion (8)", "TDD: Roman Numerals kata", "REST API: resource naming, status codes, versioning contract", "xUnit + FluentAssertions: write tests for showcase API", "First mock pairing session (find MVP partner)"] },
      { w:"W4", focus:"LLD + STAR",         tasks:["LLD: design Parking Lot (live, narrate out loud)", "DSA: Heaps, advanced BFS/DFS (8)", ".NET: async/await internals, LINQ", "Write STAR stories #1 (Leadership) and #2 (Conflict)", "C4 diagram L1 for showcase project"] },
      { w:"W5", focus:"SQL + Angular",      tasks:["SQL: indexes, query plans, N+1 problem, EF Core", "Angular: RxJS operators (map, switchMap, combineLatest)", "LLD: design URL Shortener", "Write STAR story #3 (Failure + learning)", "German: 30-day streak milestone"] },
      { w:"W6", focus:"Graphs + System",    tasks:["DSA: Graphs BFS/DFS, topological sort, union-find intro (8)", "LLD: design a Notification System", "C4 diagram L2 (container level) for showcase", "Write STAR stories #4 (Innovation) + #5 (Collaboration)", "TDD: Bank Account kata with partner"] },
      { w:"W7", focus:"Ship + CI/CD",       tasks:["Angular: HTTP client + reactive forms", "GitHub Actions: full pipeline (build → test → deploy)", "Deploy full-stack showcase to Azure (App Service + SQL)", "ADR-001: tech choices for showcase — why this stack?", "Write STAR story #6 (Social cause / DEI)"] },
      { w:"W8", focus:"TW Mock + Apply",    tasks:["2× mock pairing interviews (Pramp or MVP partner)", "Review all 6 STAR stories — say each out loud, time it", "LeetCode review sprint: 10 problems from weakest pattern", "Apply ThoughtWorks — submit application", "Ship: showcase public URL in LinkedIn bio"] },
    ],
    gates:["50+ LeetCode (all Medium)", "4 TDD katas done", "6 STAR stories written + rehearsed", "1 live showcase project at public URL", "TW application sent"],
  },
  {
    n:"2", label:"MS-READY", weeks:"Week 9–16", color: blue, icon:"☁️",
    unlock:"Microsoft Azure application → apply end of Week 16",
    goal:"Azure depth. 150 LeetCode (inc. 20 Hard). AZ-204. Ship showcase v2 with CQRS + OTEL.",
    plan: [
      { w:"W9",  focus:"Scale + Cache",          tasks:["HLD: design Instagram at scale (write it out fully)", "Redis: cache-aside, TTL, LRU, cache stampede", "DSA: DP foundations — coin change, LCS, house robber (8)", ".NET: GC internals, Span<T>, ArrayPool<T>"] },
      { w:"W10", focus:"Cosmos + Messaging",     tasks:["Cosmos DB: partition key choice, RU model, change feed", "Azure Service Bus: queues vs topics, dead letter queue", "DSA: DP medium problems (×8)", "Outbox pattern: implement in showcase (atomic publish)"] },
      { w:"W11", focus:"Distributed Systems",    tasks:["CAP theorem: pick PostgreSQL, Cosmos DB, Redis — explain each", "HLD: design a Chat System (WebSockets + fan-out)", "DSA: Graphs advanced — Dijkstra, Bellman-Ford (6)", "ADR-002: Cosmos DB partition key decision"] },
      { w:"W12", focus:"Azure Functions",        tasks:["Azure Functions: HTTP, Timer, Service Bus, Blob triggers", "Durable Functions: orchestrator + activity + fan-out", "CQRS: implement in showcase API (separate read/write models)", "DSA: Hard problems ×5 — attempt without hints"] },
      { w:"W13", focus:"Observability + Sec",    tasks:["OpenTelemetry SDK: traces (Activity) + metrics (Meter) + logs", "Key Vault + managed identity in showcase (no secrets in code)", "OWASP Top 10: read + add auth/sec to showcase", "Angular: NgRx — add state slice to showcase UI"] },
      { w:"W14", focus:"AZ-204 Sprint 1",        tasks:["AZ-204: App Service, Azure Functions, Containers, Storage", "DSA: revision — all 8 patterns back-to-back sprint (10)", "Playwright E2E tests: cover 3 critical paths in showcase"] },
      { w:"W15", focus:"AZ-204 Sprint 2",        tasks:["AZ-204: Cosmos DB, Event Grid, API Management, Key Vault", "HLD: design a Payment System (write full doc)", "Mock Microsoft system design (Pramp) — record + review", ".NET: CLR/JIT internals, async state machine under the hood"] },
      { w:"W16", focus:"MS Mock + Apply",        tasks:["AZ-204 exam: book + take", "2× full Microsoft onsite loop simulation (4 rounds)", "Review .NET internals: prepare 10 deep-dive questions", "Apply Microsoft Azure team — send application"] },
    ],
    gates:["150+ LeetCode (inc. 20 Hard)", "AZ-204 certified", "Showcase v2: CQRS + OTEL + Cosmos live", "3 HLD system designs documented", "MS application sent"],
  },
  {
    n:"3", label:"LEVEL UP", weeks:"Week 17–24", color: yellow, icon:"🚀",
    unlock:"Germany / Europe offers + senior positioning + OSS presence",
    goal:"Kubernetes. Event Sourcing. OSS contribution. German A2. Public speaking.",
    plan: [
      { w:"W17", focus:"Kubernetes",         tasks:["K8s: Pods, Deployments, Services, ConfigMaps, Secrets, HPA", "Deploy showcase to AKS with health probes and rolling update", "German: intensive A2 sprint (Babbel + iTalki session #1)"] },
      { w:"W18", focus:"Event Sourcing",     tasks:["Event Sourcing: implement event store for showcase domain", "Saga pattern: add compensating transactions (order → inventory → payment)", "German: A2 practice — write a professional email in German"] },
      { w:"W19", focus:"OSS Contribution",   tasks:["Pick 1 OSS project: Polly / OpenTelemetry .NET / EF Core", "Submit 1 PR (even docs improvement counts)", "Blog: 'What I learned reading production OSS code'"] },
      { w:"W20", focus:"Germany Pipeline",   tasks:["European 2-page CV with photo — reviewed by 1 German contact", "Apply 10 Germany jobs on StepStone.de", "German: A2 milestone check — can you have a basic conversation?"] },
      { w:"W21", focus:"Performance",        tasks:["Profile showcase API: dotnet-trace + flamegraph", "Fix 1 real bottleneck (measure → change → measure again)", "Blog: 'How I found and fixed a .NET perf issue in production'"] },
      { w:"W22", focus:"Public Speaking",    tasks:["Submit CFP to 1 meetup or conference (cloud-native topic)", "Record 15-min lightning talk — upload to YouTube", "Share on LinkedIn with context: what you built, what you learned"] },
      { w:"W23", focus:"Final Review",       tasks:["ADR audit: are all 8+ ADRs complete and honest?", "Showcase audit: all 7 layers working end-to-end?", "DSA final sprint: 20 problems from weakest patterns only"] },
      { w:"W24", focus:"Launch",             tasks:["README: live demo URL + C4 diagram + ADR links", "LinkedIn: update headline, about, experience with numbers", "Plan Month 7: which company progressed? What is next?"] },
    ],
    gates:["German A2 achieved", "1 OSS PR merged", "1 talk delivered or submitted", "Showcase on AKS with Saga + Event Sourcing", "200 LeetCode total"],
  },
];

// ── Company gates ─────────────────────────────────────────────────────────
const companies = [
  {
    name: "ThoughtWorks", icon: "🧪", color: green, applyAt: "Week 8",
    mustHave: [
      "TDD: 4 katas done, can do Red-Green-Refactor live under pressure",
      "DSA: 50+ Medium problems, no blanking on patterns",
      "SOLID: can name violations on sight, refactor live",
      "LLD: Parking Lot or URL Shortener — designed and narrated live",
      "STAR: 6 stories including social cause / DEI ready",
      "Portfolio: 1 live project at a public URL",
    ],
    rounds: [
      { r:"Online Coding",   n:"2 Medium problems, any language, 90 min" },
      { r:"Tech Interview 1",n:"DSA + SOLID + Clean Code discussion" },
      { r:"Tech Interview 2",n:"System Design LLD + architecture decisions" },
      { r:"Pairing Round",   n:"Live TDD with interviewer — narrate everything" },
      { r:"Social Values",   n:"DEI, community work, social cause — your strongest round" },
    ],
    ace: "Your Microsoft MVP + XMonkeys360 + community speaking. This is worth more than any LeetCode score at TW.",
  },
  {
    name: "Microsoft Azure", icon: "☁️", color: blue, applyAt: "Week 16",
    mustHave: [
      "DSA: 150+ problems, Hard problems not scary (even if slow)",
      ".NET internals: GC, CLR, JIT, async state machine — explain any",
      "Azure: App Service, Functions, Cosmos DB, Service Bus — real depth",
      "HLD: can design 3 systems at 1M+ scale with tradeoffs",
      "AZ-204 certified",
      "Showcase: CQRS + OTEL + Cosmos DB visible on GitHub",
    ],
    rounds: [
      { r:"Recruiter Screen",     n:"Background, motivation, salary range" },
      { r:"Phone Screen",         n:"1 DSA problem (Medium) + .NET deep dive questions" },
      { r:"Onsite Round 1",       n:"DSA — 2 problems (Medium to Hard)" },
      { r:"Onsite Round 2",       n:"System Design at Azure scale (distributed)" },
      { r:"Onsite Round 3",       n:".NET / C# internals deep dive" },
      { r:"Onsite Round 4",       n:"Behavioral — STAR method 45 min" },
    ],
    ace: "MVP credential gives insider credibility. Network via MVP Insider community before Week 16 — start Month 1.",
  },
  {
    name: "Germany / Europe", icon: "🇩🇪", color: yellow, applyAt: "Apply from W1 — offers by W20+",
    mustHave: [
      "German: A2 minimum (B1 preferred for Munich/Berlin roles)",
      "European 2-page CV with photo — no US resume format",
      "EU Blue Card eligibility (IT is shortage occupation — lower salary threshold)",
      "All TW + MS technical skills — tech bar is same globally",
      "Know your 3 numbers: walk-away / target / stretch (India + Germany separately)",
    ],
    rounds: [
      { r:"CV Screening",         n:"European 2-page CV with photo — include MVP prominently" },
      { r:"HR Interview",         n:"Motivation for Germany, visa status, salary expectations" },
      { r:"Technical Interview",  n:"Same as big tech — DSA + system design" },
      { r:"Team Fit Interview",   n:"Cultural alignment + English/German communication" },
      { r:"Offer + Visa",         n:"EU Blue Card — 2–3 months processing after offer" },
    ],
    ace: "Siemens internal mobility to Munich is your fastest route. Start in the Siemens internal portal at Week 1.",
  },
];

// ── Ultra-compact daily schedule ─────────────────────────────────────────
const daily = [
  { time:"6:30 AM",  tag:"GERMAN",   color: yellow, task:"15 min Duolingo + Babbel — streak every single day, no exception" },
  { time:"7:00 AM",  tag:"DSA",      color: green,  task:"1 LeetCode problem, TDD-first (write test → fail → pass → refactor), 30 min" },
  { time:"Work Day", tag:"OBSERVE",  color: muted,  task:"Apply learnings at Siemens. Notice every architecture decision made by the team" },
  { time:"7:00 PM",  tag:"STACK",    color: blue,   task:"Primary stack for the week (see phase plan above) — 90 min deep focused work" },
  { time:"8:30 PM",  tag:"SHIP",     color: orange, task:"Build showcase feature OR write ADR OR write blog post — 45 min. Ship something." },
  { time:"9:15 PM",  tag:"KATA/MOCK",color: purple, task:"TDD kata (W1–8) OR mock interview (W7+) OR STAR story review — 30 min" },
];

// ── Progress counters ─────────────────────────────────────────────────────
const counters = [
  { label:"LeetCode", id:"lc",   max:200, color: green,  icon:"💻" },
  { label:"German Days", id:"de",max:168, color: yellow, icon:"🇩🇪" },
  { label:"Jobs Applied", id:"j",max:240, color: blue,   icon:"📨" },
  { label:"ADRs Written", id:"a",max:12,  color: orange, icon:"📐" },
  { label:"Blog Posts",   id:"b",max:12,  color: purple, icon:"✍️" },
  { label:"Mock Interviews",id:"m",max:24,color: red,    icon:"🎤" },
];
---

<Layout title="Operation Big Tech — Logesh Palani">
<div style={`font-family:'JetBrains Mono','Fira Code','Cascadia Code','Consolas',monospace;background:${bg};min-height:100vh;color:${textColor};font-size:15px`}>

  <!-- ── Header ── -->
  <div style={`background:linear-gradient(135deg,#07101F 0%,#0A152B 60%,#07101F 100%);border-bottom:1px solid ${border};padding:24px 24px 20px;position:relative;overflow:hidden`}>
    <div style="position:absolute;inset:0;background-image:radial-gradient(ellipse at 10% 50%,rgba(0,255,163,0.06) 0%,transparent 55%),radial-gradient(ellipse at 85% 20%,rgba(56,189,248,0.06) 0%,transparent 55%)"></div>
    <div style="position:relative;max-width:920px;margin:0 auto">
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;flex-wrap:wrap">
        <span style={`background:${green};color:#000;padding:2px 9px;font-size:10px;font-weight:800;letter-spacing:2px`}>MVP</span>
        <span style={`color:${muted};font-size:12px;letter-spacing:1.5px`}>LOGESH PALANI · SIEMENS · BENGALURU · Apr 2026</span>
      </div>
      <h1 style={`font-size:clamp(20px,4vw,32px);font-weight:800;margin:0 0 6px;background:linear-gradient(100deg,${green} 0%,${blue} 50%,${purple} 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent`}>OPERATION BIG TECH</h1>
      <p style={`color:${dim};font-size:14px;margin:0 0 18px`}>24-week combined learning path → ThoughtWorks → Microsoft Azure → Germany. One prep. Three exits.</p>
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        {[{n:"ThoughtWorks",c:green,t:"Apply W8"},{n:"Microsoft Azure",c:blue,t:"Apply W16"},{n:"Germany",c:yellow,t:"Parallel W1+"}].map(t=>(
          <div style={`background:${t.c}0D;border:1px solid ${t.c}30;padding:6px 14px;display:flex;align-items:center;gap:8px`}>
            <span style={`color:${t.c};font-size:12px;font-weight:700`}>{t.n}</span>
            <span style={`color:${muted};font-size:11px`}>{t.t}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- ── Sticky Nav ── -->
  <div style={`position:sticky;top:0;z-index:100;background:#0A1020;border-bottom:1px solid ${border};overflow-x:auto;scrollbar-width:none`}>
    <div style="display:flex;min-width:max-content;padding:0 8px">
      {[
        {id:"path",    l:"📅 Learning Path"},
        {id:"stacks",  l:"🧮 All Stacks"},
        {id:"gates",   l:"🚪 Company Gates"},
        {id:"daily",   l:"⏱️ Daily Schedule"},
        {id:"progress",l:"📊 Progress"},
        {id:"cloud",   l:"☁️ Cloud-Native"},
      ].map(s=>(
        <a href={`#${s.id}`} style={`color:${muted};text-decoration:none;padding:10px 14px;font-size:13px;white-space:nowrap;border-bottom:2px solid transparent;display:block;font-family:inherit`}>{s.l}</a>
      ))}
    </div>
  </div>

  <div style="padding:24px 20px;max-width:920px;margin:0 auto">

    <!-- ══════════════════════════════════════════════════════════════════ -->
    <!-- SECTION: LEARNING PATH                                            -->
    <!-- ══════════════════════════════════════════════════════════════════ -->
    <div id="path" style="scroll-margin-top:44px">

      <div style={`background:${green}08;border:1px solid ${green}25;padding:14px 18px;margin-bottom:24px`}>
        <span style={`color:${green};font-size:11px;font-weight:800;letter-spacing:2px`}>THE RULE: </span>
        <span style={`color:${dim};font-size:14px`}>Every week has a focus. Do 1 LeetCode + German every single day. Ship something every Friday. Review every Sunday. Never break the chain.</span>
      </div>

      {phases.map(phase=>(
        <div style={`margin-bottom:36px`}>
          <!-- Phase header -->
          <div style={`background:linear-gradient(90deg,${phase.color}12,transparent);border:1px solid ${phase.color}30;border-left:4px solid ${phase.color};padding:16px 20px;margin-bottom:16px`}>
            <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:8px">
              <span style="font-size:20px">{phase.icon}</span>
              <span style={`color:${phase.color};font-size:17px;font-weight:800`}>Phase {phase.n}: {phase.label}</span>
              <span style={`background:${phase.color}18;color:${phase.color};padding:2px 10px;font-size:11px;font-weight:700;border:1px solid ${phase.color}40`}>{phase.weeks}</span>
            </div>
            <p style={`color:${dim};font-size:13px;margin:0 0 10px;line-height:1.7`}>{phase.goal}</p>
            <div style={`color:${phase.color};font-size:12px;font-weight:700`}>🔓 {phase.unlock}</div>
          </div>

          <!-- Week cards grid -->
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:10px;margin-bottom:14px">
            {phase.plan.map(wk=>(
              <div style={`background:${card};border:1px solid ${border};border-top:2px solid ${phase.color}60;padding:14px 16px`}>
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
                  <span style={`background:${phase.color}15;color:${phase.color};padding:3px 8px;font-size:11px;font-weight:800;min-width:28px;text-align:center`}>{wk.w}</span>
                  <span style={`color:${textColor};font-size:13px;font-weight:700`}>{wk.focus}</span>
                </div>
                <div style="display:grid;gap:5px">
                  {wk.tasks.map(t=>(
                    <div style="display:flex;gap:8px;align-items:flex-start">
                      <span style={`color:${phase.color};font-size:11px;margin-top:3px;opacity:0.7;flex-shrink:0`}>▸</span>
                      <span style={`color:${dim};font-size:12px;line-height:1.6`}>{t}</span>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>

          <!-- Phase gates (checklist) -->
