          { b:"Build in public", c:"#FBBF24", n:"OSS contributions, blog posts, conference talks, GitHub READMEs that teach. Teaching forces the depth that makes you top 1%." },
          { b:"Own it end-to-end", c:"#F87171", n:"Networking, deployment, monitoring, cost, security. Not expert in all — but fluent enough to reason about all." },
        ].map(b=>(
          <div style={`background:#111827;border:1px solid #1E2A3B;border-top:2px solid ${b.c};padding:14px`}>
            <div style={`color:${b.c};font-size:13px;font-weight:800;margin-bottom:6px`}>{b.b}</div>
            <p style="color:#94A3B8;font-size:12px;line-height:1.65;margin:0">{b.n}</p>
          </div>
        ))}
      </div>

    </div>

  </div>

  <!-- ── Footer ── -->
  <div style={`border-top:1px solid ${border};padding:14px 24px;text-align:center;margin-top:24px`}>
    <div style={`color:${muted};font-size:12px;letter-spacing:2px`}>LOGESH PALANI · MICROSOFT MVP · OPERATION BIG TECH · 2026</div>
    <div style="margin-top:6px;display:flex;justify-content:center;gap:16px;flex-wrap:wrap">
      {[{l:"Track 1",n:"ThoughtWorks",c:green},{l:"Track 2",n:"Microsoft Azure",c:blue},{l:"Track 3",n:"Germany",c:yellow}].map(t=>(
        <span style="font-size:12px">
          <span style={`color:${muted}`}>{t.l}: </span>
          <span style={`color:${t.c}`}>{t.n}</span>
        </span>
      ))}
    </div>
  </div>

</div>
</Layout>

<script>
  const state: Record<string, number> = {};

  function refreshCounter(id: string) {
    const valEl = document.querySelector<HTMLElement>(`.counter-val[data-id="${id}"]`)!;
    const max   = parseInt(valEl.dataset.max!);
    const val   = state[id] ?? 0;
    const pct   = Math.round((val / max) * 100);
    valEl.textContent = String(val);
    (document.querySelector<HTMLElement>(`.counter-bar[data-id="${id}"]`))!.style.width = `${Math.min(pct,100)}%`;
    (document.querySelector<HTMLElement>(`.counter-pct[data-id="${id}"]`))!.textContent = `${pct}%`;
  }

  document.querySelectorAll<HTMLButtonElement>('.counter-inc').forEach(btn => {
    const id  = btn.dataset.id!;
    const max = parseInt(btn.dataset.max!);
    state[id] ??= 0;
    btn.addEventListener('click', () => { state[id] = Math.min(state[id] + 1, max); refreshCounter(id); });
  });

  document.querySelectorAll<HTMLButtonElement>('.counter-dec').forEach(btn => {
    const id = btn.dataset.id!;
    btn.addEventListener('click', () => { state[id] = Math.max((state[id] ?? 0) - 1, 0); refreshCounter(id); });
  });

  document.querySelectorAll<HTMLInputElement>('.milestone-cb').forEach(cb => {
    cb.addEventListener('change', () => {
      const span = cb.closest('label')!.querySelector('span') as HTMLElement;
      if (span) {
        span.style.textDecoration = cb.checked ? 'line-through' : 'none';
        span.style.opacity        = cb.checked ? '0.4' : '1';
      }
    });
  });
</script>
