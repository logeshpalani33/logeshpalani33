      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px;margin-bottom:28px">
        {[
          { icon:"🔌", name:"Sidecar",        color:"#38BDF8", what:"Helper container in the same Pod. Used for logging agents, service mesh proxies (Envoy), config reloaders.", when:"Need shared infra concerns without changing app code.", eg:"Envoy as sidecar in Istio — handles mTLS, retries, metrics transparently." },
          { icon:"⚡", name:"Circuit Breaker", color:"#F87171", what:"Stop calling a failing service after N failures. Closed → Open → Half-Open. Prevents cascade failures.", when:"Any synchronous HTTP/gRPC call to an external dependency.", eg:"Polly CircuitBreakerPolicy: open after 5 failures in 10s, test after 30s." },
          { icon:"📮", name:"Outbox Pattern",  color:"#00FFA3", what:"Write to DB and outbox table in same transaction. Worker polls outbox and publishes to message bus.", when:"Need to publish events AND update DB atomically, no distributed transactions.", eg:"INSERT order + INSERT outbox_event in one SQL tx. Worker publishes to Service Bus." },
