const tabs = ["🎯 Tracks & Phases","📅 Daily Routine","🗓️ Weekly Plan","📚 Resources","📘 Detailed Plan","🎤 Interview Prep","📊 Progress"];
const progressCounters = [
  { label: "LeetCode Problems", id: "leetcode", max: 150, color: green,  icon: "💻" },
  { label: "German Streak Days",id: "german",   max: 180, color: yellow, icon: "🇩🇪" },
  { label: "Jobs Applied",      id: "jobs",     max: 240, color: blue,   icon: "📨" },
  { label: "Mock Interviews",   id: "mocks",    max: 24,  color: purple, icon: "🎤" },
];
---

<Layout title="Operation Big Tech — Logesh Palani">
  <div style={`font-family:'JetBrains Mono','Fira Code','Cascadia Code','Consolas','Courier New',monospace;background:${bg};min-height:100vh;color:${textColor};font-size:15px`}>

    <!-- ── Header ── -->
    <div style={`background:linear-gradient(135deg,#07101F 0%,#0A152B 60%,#07101F 100%);border-bottom:1px solid ${border};padding:28px 24px 22px;position:relative;overflow:hidden`}>
      <div style="position:absolute;top:0;left:0;right:0;bottom:0;background-image:radial-gradient(ellipse at 10% 50%,rgba(0,255,163,0.06) 0%,transparent 55%),radial-gradient(ellipse at 85% 20%,rgba(56,189,248,0.06) 0%,transparent 55%),radial-gradient(ellipse at 50% 90%,rgba(167,139,250,0.04) 0%,transparent 50%)"></div>
      <div style="position:relative;max-width:900px;margin:0 auto">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;flex-wrap:wrap">
          <span style={`background:${green};color:#000;padding:3px 10px;font-size:10px;font-weight:800;letter-spacing:2px`}>MVP</span>
          <span style={`color:${muted};font-size:12px;letter-spacing:1.5px`}>LOGESH PALANI · SIEMENS · BENGALURU</span>
        </div>
        <h1 style={`font-size:clamp(22px,5vw,36px);font-weight:800;margin:0 0 6px;letter-spacing:1px;background:linear-gradient(100deg,${green} 0%,${blue} 50%,${purple} 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent`}>OPERATION BIG TECH</h1>
        <p style={`color:${dim};font-size:15px;margin:0 0 20px`}>One prep. Three exits. Take whichever opens first.</p>
        <div style="display:flex;gap:10px;flex-wrap:wrap">
          {profileTracks.map(t => (
            <div style={`background:${t.color}0D;border:1px solid ${t.color}35;padding:8px 16px;display:flex;align-items:center;gap:10px`}>
              <div style={`width:24px;height:24px;border-radius:50%;background:${t.color}18;border:1px solid ${t.color}40;color:${t.color};font-size:11px;font-weight:800;display:flex;align-items:center;justify-content:center`}>{t.id}</div>
              <div>
                <div style={`color:${t.color};font-size:12px;font-weight:700`}>{t.name}</div>
                <div style={`color:${muted};font-size:10px`}>{t.when}</div>
              </div>
              <span style="font-size:18px;margin-left:2px">{t.icon}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- ── Tabs ── -->
    <div style={`display:flex;overflow-x:auto;border-bottom:1px solid ${border};background:#0A1020`}>
      {tabs.map((tab, i) => (
        <button class="tab-btn" data-tab={i}
          style={`background:none;border:none;cursor:pointer;padding:14px 20px;font-size:14px;white-space:nowrap;font-family:inherit;letter-spacing:0.2px;color:${i===0?green:muted};border-bottom:${i===0?`2px solid ${green}`:'2px solid transparent'};font-weight:${i===0?'600':'400'}`}
        >{tab}</button>
      ))}
    </div>

    <div style="padding:24px 20px;max-width:900px;margin:0 auto">

      <!-- ── TAB 0: Tracks & Phases ── -->
      <div class="tab-panel" data-panel="0">
        <div style={`background:${green}0A;border:1px solid ${green}25;padding:16px 20px;margin-bottom:28px`}>
          <div style={`color:${green};font-size:12px;font-weight:800;letter-spacing:2px;margin-bottom:10px`}>READ THIS FIRST — THE ONE INSIGHT</div>
          <p style={`color:${dim};font-size:15px;line-height:1.9;margin:0`}>
            90% of preparation is <span style={`color:${green};font-weight:700`}>identical</span> across all 3 tracks. DSA, system design, .NET internals, Angular, behavioral stories — do it once. The additions per track are small. You are not doing three preps.
            <span style={`color:${textColor};font-weight:700`}> You are doing one prep with three possible exits. Take whichever opens first.</span>
          </p>
        </div>

        <div style={`color:${green};font-size:12px;font-weight:800;letter-spacing:2px;margin-bottom:12px`}>THREE TRACKS · PRIORITY ORDER</div>
        {tracks.map(t => (
          <details style={`background:${card};border:1px solid ${border};border-left:4px solid ${t.color};margin-bottom:10px;overflow:hidden`}>
            <summary style="padding:16px 20px;cursor:pointer;display:flex;align-items:flex-start;gap:14px;list-style:none">
              <div style={`min-width:36px;height:36px;border-radius:50%;background:${t.color2};border:1px solid ${t.color}40;color:${t.color};font-size:15px;font-weight:800;display:flex;align-items:center;justify-content:center`}>{t.rank}</div>
              <div style="flex:1;min-width:0">
                <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:5px">
                  <span style="font-size:18px">{t.icon}</span>
                  <span style={`color:${t.color};font-size:16px;font-weight:700`}>{t.name}</span>
                  <span style={`background:${t.color2};color:${t.color};font-size:10px;padding:2px 9px;border:1px solid ${t.color}30`}>{t.when}</span>
                </div>
                <p style={`color:${dim};font-size:14px;line-height:1.8;margin:0 0 10px`}>{t.why}</p>
                <div style={`background:${surface};padding:10px 14px;border-left:2px solid ${t.color}50`}>
                  <span style={`color:${t.color};font-size:12px;font-weight:700`}>ADDITIONS ONLY: </span>
                  <span style={`color:${dim};font-size:13px`}>{t.extra}</span>
                </div>
              </div>
            </summary>
            <div style={`border-top:1px solid ${border};padding:16px 20px`}>
              <div style={`color:${t.color};font-size:10px;font-weight:700;letter-spacing:1px;margin-bottom:10px`}>INTERVIEW ROUNDS</div>
              {t.rounds.map((r, j) => (
                <div style="display:flex;gap:12px;margin-bottom:8px;align-items:flex-start">
                  <div style={`min-width:24px;height:24px;background:${t.color2};border:1px solid ${t.color}30;color:${t.color};font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center`}>{j+1}</div>
                  <div>
                    <div style={`color:${textColor};font-size:14px;font-weight:600`}>{r.name}</div>
                    <div style={`color:${muted};font-size:13px;margin-top:3px`}>{r.note}</div>
                  </div>
                </div>
              ))}
            </div>
          </details>
        ))}

        <div style={`color:${blue};font-size:12px;font-weight:800;letter-spacing:2px;margin:28px 0 12px`}>6-MONTH PHASE PLAN</div>
        {phases.map((p, i) => (
          <details open={i===0} style={`background:${card};border:1px solid ${border};border-left:3px solid ${p.color};margin-bottom:10px;overflow:hidden`}>
            <summary style="padding:14px 18px;cursor:pointer;display:flex;align-items:center;gap:12px;list-style:none">
              <span style="font-size:20px">{p.icon}</span>
              <div style="flex:1">
                <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:3px">
                  <span style={`color:${p.color};font-weight:700;font-size:11px`}>{p.phase}</span>
                  <span style={`background:${p.color}15;color:${p.color};font-size:10px;padding:2px 8px;border:1px solid ${p.color}25`}>{p.months}</span>
                </div>
                <div style={`font-size:14px;font-weight:700;color:${textColor}`}>{p.title}</div>
                <div style={`font-size:11px;color:${muted};margin-top:2px`}>{p.subtitle}</div>
              </div>
            </summary>
            <div style={`border-top:1px solid ${border};padding:16px 18px`}>
              <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px">
                <div>
                  <div style={`color:${p.color};font-size:10px;font-weight:700;letter-spacing:1px;margin-bottom:12px`}>PRIMARY FOCUS</div>
                  {p.primary.map(g => (
                    <div style="display:flex;gap:8px;margin-bottom:8px">
                      <span style={`color:${p.color};margin-top:3px;flex-shrink:0`}>▸</span>
                      <span style={`color:${dim};font-size:14px;line-height:1.7`}>{g}</span>
                    </div>
                  ))}
                </div>
                <div>
                  <div style={`color:${p.secondaryColor};font-size:10px;font-weight:700;letter-spacing:1px;margin-bottom:12px`}>{p.secondaryLabel.toUpperCase()}</div>
                  {p.secondary.map(g => (
                    <div style="display:flex;gap:8px;margin-bottom:8px">
                      <span style={`color:${p.secondaryColor};margin-top:3px;flex-shrink:0`}>·</span>
                      <span style={`color:${muted};font-size:14px;line-height:1.7`}>{g}</span>
                    </div>
                  ))}
                  <div style={`margin-top:14px;background:${p.color}0D;border:1px solid ${p.color}20;padding:10px 12px`}>
                    <div style={`color:${p.color};font-size:12px;font-weight:700;margin-bottom:6px`}>PHASE MILESTONE</div>
                    <div style={`color:${dim};font-size:13px;line-height:1.7`}>{p.milestone}</div>
                  </div>
                </div>
              </div>
            </div>
          </details>
        ))}

        <div style={`background:${card};border:1px solid ${border};padding:18px 20px;margin-top:10px`}>
          <div style={`color:${green};font-size:12px;font-weight:800;letter-spacing:2px;margin-bottom:14px`}>GOLDEN RULES — COMMIT THESE TO MEMORY</div>
          {rules.map(r => (
            <div style="display:flex;gap:10px;margin-bottom:9px;align-items:flex-start">
              <span style={`color:${r.color};font-size:15px;margin-top:2px`}>→</span>
              <span style={`color:${dim};font-size:15px;line-height:1.7`}>{r.text}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- ── TAB 1: Daily Routine ── -->
      <div class="tab-panel" data-panel="1" style="display:none">
        <div style={`background:${green}0A;border:1px solid ${green}25;padding:12px 16px;margin-bottom:22px`}>
          <span style={`color:${green};font-size:12px;font-weight:700`}>KEY CHANGE: </span>
          <span style={`color:${dim};font-size:14px`}>The 7 AM LeetCode slot now uses TDD — write the failing test first, then implement. Same 30 mins, same habit. This one change prepares you for the ThoughtWorks pairing round without adding any extra time.</span>
        </div>
        <div style="position:relative">
          <div style={`position:absolute;left:80px;top:0;bottom:0;width:1px;background:${border}`}></div>
          {daily.map(slot => (
            <div style="display:flex;margin-bottom:8px;align-items:flex-start">
              <div style={`min-width:80px;font-size:13px;color:${muted};padding-top:10px;text-align:right;padding-right:16px`}>{slot.time}</div>
              <div style={`width:12px;height:12px;border-radius:50%;background:${slot.color};margin-top:11px;min-width:12px;position:relative;z-index:1;border:2px solid ${bg}`}></div>
              <div style={`background:${card};border:1px solid ${border};border-left:2px solid ${slot.color}60;padding:9px 14px;flex:1;margin-left:14px`}>
                <span style={`color:${slot.color};font-size:12px;font-weight:700;margin-right:8px`}>{slot.tag} {slot.label}</span>
                <div style={`color:${dim};font-size:14px;margin-top:4px;line-height:1.65`}>{slot.task}</div>
              </div>
            </div>
          ))}
        </div>
        <div style={`background:${card};border:1px solid ${yellow}30;padding:14px 18px;margin-top:16px`}>
          <div style={`color:${yellow};font-size:12px;font-weight:700;margin-bottom:10px`}>ON BAD DAYS — MINIMUM VIABLE DAY</div>
          <p style={`color:${dim};font-size:14px;line-height:1.8;margin:0`}>If you only have 30 minutes, do <span style={`color:${green}`}>1 LeetCode + German streak</span>. That's it. A 1-problem day is infinitely better than a 0-problem day. The streak matters more than any single session.</p>
        </div>
      </div>

      <!-- ── TAB 2: Weekly Plan ── -->
      <div class="tab-panel" data-panel="2" style="display:none">
        <p style={`color:${muted};font-size:14px;margin-bottom:20px`}>Each day has a primary technical focus. Saturday's pairing session is new — find a partner in your MVP network. German streak runs every single day without exception.</p>
        <div style="display:grid;gap:8px">
          {weekly.map(day => (
            <div style={`background:${card};border:1px solid ${border};border-left:3px solid ${day.color};padding:12px 18px;display:grid;grid-template-columns:64px 1fr;gap:14px;align-items:start`}>
              <div>
                <div style={`color:${day.color};font-weight:700;font-size:14px`}>{day.short}</div>
                <div style={`color:${muted};font-size:10px;margin-top:3px;line-height:1.4`}>{day.focus}</div>
              </div>
              <div style="display:flex;flex-wrap:wrap;gap:6px">
                {day.tasks.map(task => (
                  <div style={`background:${surface};padding:6px 12px;font-size:13px;color:${dim};border:1px solid ${border}`}>
                    <span style={`color:${day.color}`}>▸ </span>{task}
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
        <div style={`background:${card};border:1px solid ${yellow}30;padding:16px 18px;margin-top:16px`}>
          <div style={`color:${yellow};font-size:12px;font-weight:700;letter-spacing:1px;margin-bottom:14px`}>WEEKLY NON-NEGOTIABLES — HIT ALL 7</div>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px">
            {nonneg.map(t => (
              <div style={`background:${surface};padding:10px 12px;border:1px solid ${border}`}>
                <div style={`color:${t.color};font-size:18px;font-weight:800`}>{t.value}</div>
                <div style={`color:${muted};font-size:12px;margin-top:4px`}>{t.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- ── TAB 3: Resources ── -->
      <div class="tab-panel" data-panel="3" style="display:none">
        <div style={`background:${red}0A;border:1px solid ${red}25;padding:10px 16px;margin-bottom:20px`}>
          <span style={`color:${red};font-size:12px;font-weight:700`}>RULE: </span>
          <span style={`color:${dim};font-size:14px`}>Do not add more resources. Finish what's listed here. One NeetCode problem solved deeply is worth ten problems skimmed.</span>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(275px,1fr));gap:14px">
          {resources.map(r => (
            <div style={`background:${card};border:1px solid ${border};border-top:2px solid ${r.color};padding:16px`}>
              <div style="display:flex;align-items:center;gap:8px;margin-bottom:14px">
                <span style="font-size:18px">{r.icon}</span>
                <span style={`color:${r.color};font-weight:700;font-size:11px;letter-spacing:1px`}>{r.cat.toUpperCase()}</span>
              </div>
              {r.items.map(item => (
                <div style={`background:${surface};padding:10px 12px;margin-bottom:8px;border-left:2px solid ${r.color}40`}>
                  <div style={`color:${textColor};font-size:14px;font-weight:600;margin-bottom:3px`}>{item.name}</div>
                  {item.href
                    ? <a href={item.href} target="_blank" rel="noreferrer" style={`color:${r.color};font-size:12px;display:inline-block;margin-top:2px;text-decoration:underline;text-decoration-style:dotted;opacity:0.85`}>{item.url}</a>
                    : <span style={`color:${muted};font-size:12px;margin-top:2px;display:inline-block;font-style:italic`}>{item.url}</span>
                  }
                  <div style={`color:${dim};font-size:13px;margin-top:5px;line-height:1.5`}>→ {item.note}</div>
                </div>
              ))}
            </div>
          ))}
        </div>
      </div>

      <!-- ── TAB 4: Detailed Plan ── -->
      <div class="tab-panel" data-panel="4" style="display:none">
        <div style={`background:${blue}10;border:1px solid ${blue}25;padding:14px 18px;margin-bottom:18px`}>
          <div style={`color:${blue};font-size:12px;font-weight:800;letter-spacing:1.5px;margin-bottom:8px`}>FULL DETAILED PLAN · 24 WEEKS</div>
          <p style={`color:${dim};font-size:14px;line-height:1.75;margin:0`}>This section gives deep execution detail for DSA, System Design, .NET, Angular, Azure, behavioral prep, and Germany pipeline. Follow it as an operating manual: complete phase items, ship outputs weekly, and review gaps every Sunday.</p>
        </div>
        <div style="display:grid;gap:12px">
          {detailedPlan.map(plan => (
            <div style={`background:${card};border:1px solid ${border};border-left:4px solid ${plan.color};padding:16px 18px`}>
              <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;flex-wrap:wrap">
                <span style="font-size:18px">{plan.icon}</span>
                <span style={`color:${plan.color};font-size:15px;font-weight:700`}>{plan.title}</span>
              </div>
              <p style={`color:${dim};font-size:14px;margin:0 0 12px;line-height:1.7`}>{plan.objective}</p>
              {plan.blocks.map(block => (
                <div style={`background:${surface};border:1px solid ${border};padding:12px;margin-bottom:9px`}>
                  <div style={`color:${plan.color};font-size:13px;font-weight:700;margin-bottom:8px`}>{block.phase}</div>
                  {block.items.map(item => (
                    <div style="display:flex;gap:8px;margin-bottom:6px;align-items:flex-start">
                      <span style={`color:${plan.color};margin-top:2px`}>▸</span>
                      <span style={`color:${muted};font-size:13px;line-height:1.65`}>{item}</span>
                    </div>
                  ))}
                </div>
              ))}
            </div>
          ))}
        </div>
      </div>

      <!-- ── TAB 5: Interview Prep ── -->
      <div class="tab-panel" data-panel="5" style="display:none">
        <div style={`color:${purple};font-size:12px;font-weight:800;letter-spacing:2px;margin-bottom:12px`}>BEHAVIORAL — STAR METHOD STORIES TO PREPARE</div>
        <p style={`color:${muted};font-size:14px;margin-bottom:18px;line-height:1.8`}>Prepare all 6 stories. Write them out in full — Situation, Task, Action, Result. Your MVP community work and Siemens experience give you rich material. The social cause story is your most important asset for ThoughtWorks Round 5.</p>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px;margin-bottom:28px">
          {starStories.map(s => (
            <div style={`background:${card};border:1px solid ${border};border-left:3px solid ${s.color};padding:14px 16px`}>
              <div style={`color:${s.color};font-size:14px;font-weight:700;margin-bottom:8px`}>{s.title}</div>
              <div style={`color:${muted};font-size:13px;line-height:1.65`}>{s.prompt}</div>
            </div>
          ))}
        </div>

        <div style={`color:${green};font-size:12px;font-weight:800;letter-spacing:2px;margin-bottom:12px`}>THOUGHTWORKS — YOUR SOCIAL CAUSE ANSWER</div>
        <div style={`background:${card};border:1px solid ${green}30;padding:16px 18px;margin-bottom:28px`}>
          {twSocialCause.map((part, i) => (
            <div style={`margin-bottom:12px;padding-bottom:12px;${i < twSocialCause.length-1 ? `border-bottom:1px solid ${border}` : ''}`}>
              <div style={`color:${part.color};font-size:12px;font-weight:700;margin-bottom:6px`}>{part.label.toUpperCase()}</div>
              <p style={`color:${dim};font-size:15px;line-height:1.8;margin:0`}>{part.text}</p>
            </div>
          ))}
        </div>

        <div style={`color:${green};font-size:12px;font-weight:800;letter-spacing:2px;margin-bottom:12px`}>THOUGHTWORKS — TDD PAIRING ROUND GUIDE</div>
        <div style={`background:${card};border:1px solid ${border};padding:16px 18px;margin-bottom:24px`}>
          <p style={`color:${dim};font-size:15px;line-height:1.8;margin:0 0 16px`}>ThoughtWorks is not testing if your code works. They are testing <span style={`color:${green}`}>how you think, communicate, and collaborate while coding.</span> A candidate who writes perfect code silently loses to a candidate who writes decent code and narrates every thought.</p>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px">
            {twPairingSteps.map(s => (
              <div style={`background:${surface};padding:10px 12px;border-left:2px solid ${s.color}50`}>
                <div style={`color:${s.color};font-size:13px;font-weight:700;margin-bottom:5px`}>{s.step}</div>
                <div style={`color:${muted};font-size:13px;line-height:1.65`}>{s.note}</div>
              </div>
            ))}
          </div>
        </div>

        <div style={`color:${blue};font-size:12px;font-weight:800;letter-spacing:2px;margin-bottom:12px`}>.NET INTERNALS — MICROSOFT INTERVIEW MUST-KNOWS</div>
        <div style={`background:${card};border:1px solid ${border};padding:16px 18px`}>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:8px">
            {dotnetTopics.map(t => (
              <div style={`background:${surface};padding:9px 12px;border-left:2px solid ${t.color}40`}>
                <div style={`color:${t.color};font-size:14px;font-weight:700`}>{t.topic}</div>
                <div style={`color:${muted};font-size:13px;margin-top:4px;line-height:1.55`}>{t.note}</div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- ── TAB 6: Progress ── -->
      <div class="tab-panel" data-panel="6" style="display:none">
        <div style={`color:${green};font-size:13px;font-weight:800;letter-spacing:2px;margin-bottom:6px`}>YOUR PROGRESS DASHBOARD</div>
        <p style={`color:${muted};font-size:14px;margin-bottom:24px;line-height:1.65`}>Track your key metrics toward the 6-month goal. Click + / − to update. Check off milestones as you complete them.</p>

        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;margin-bottom:32px">
          {progressCounters.map(m => (
            <div style={`background:${card};border:1px solid ${border};border-top:3px solid ${m.color};padding:18px 16px`}>
              <div style={`color:${m.color};font-size:13px;font-weight:700;margin-bottom:14px`}>{m.icon} {m.label}</div>
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px">
                <button class="counter-dec" data-id={m.id}
                  style={`background:${surface};border:1px solid ${border};color:${muted};width:32px;height:32px;cursor:pointer;font-size:18px;font-family:inherit`}>−</button>
                <span class="counter-val" data-id={m.id} data-max={m.max}
                  style={`color:${textColor};font-size:32px;font-weight:800;min-width:60px;text-align:center`}>0</span>
                <button class="counter-inc" data-id={m.id} data-max={m.max}
                  style={`background:${m.color}18;border:1px solid ${m.color}50;color:${m.color};width:32px;height:32px;cursor:pointer;font-size:18px;font-family:inherit`}>+</button>
              </div>
              <div style={`background:${surface};height:8px;border-radius:4px;overflow:hidden;margin-bottom:8px`}>
                <div class="counter-bar" data-id={m.id} data-max={m.max}
                  style={`width:0%;height:100%;background:${m.color};transition:width 0.3s ease;border-radius:4px`}></div>
              </div>
              <div style="display:flex;justify-content:space-between">
                <span class="counter-pct" data-id={m.id} style={`color:${muted};font-size:12px`}>0% done</span>
                <span style={`color:${muted};font-size:12px`}>target: {m.max}</span>
              </div>
            </div>
          ))}
        </div>

        <div style={`color:${blue};font-size:13px;font-weight:800;letter-spacing:2px;margin-bottom:14px`}>PHASE MILESTONES — CHECK OFF AS YOU COMPLETE</div>
        {phases.map(p => (
          <div style={`background:${card};border:1px solid ${border};border-left:4px solid ${p.color};padding:18px 20px;margin-bottom:12px`}>
            <div style={`color:${p.color};font-size:15px;font-weight:700;margin-bottom:14px`}>{p.icon} {p.phase} · {p.months} — {p.title}</div>
            {[...p.primary, `✦ MILESTONE: ${p.milestone}`].map((task, ti) => {
              const isMilestone = ti === p.primary.length;
              return (
                <label style="display:flex;gap:12px;align-items:flex-start;margin-bottom:10px;cursor:pointer">
                  <input type="checkbox" class="milestone-cb" style={`margin-top:4px;accent-color:${p.color};width:16px;height:16px;flex-shrink:0;cursor:pointer`} />
                  <span style={`color:${isMilestone ? p.color : dim};font-size:14px;line-height:1.6;font-weight:${isMilestone ? '600' : '400'}`}>{task}</span>
                </label>
              );
            })}
          </div>
        ))}

        <div style={`background:${green}08;border:1px solid ${green}25;padding:20px 22px;margin-top:8px`}>
          <p style={`color:${dim};font-size:15px;line-height:1.8;margin:0`}>Keep going, Logesh. Every problem solved, every day of German, every commit — it compounds. <span style={`color:${green};font-weight:600`}>One prep. Three exits. Take whichever opens first.</span></p>
        </div>
      </div>

    </div>

    <!-- ── Footer ── -->
    <div style={`border-top:1px solid ${border};padding:16px 24px;text-align:center`}>
      <div style={`color:${muted};font-size:12px;letter-spacing:2px`}>LOGESH PALANI · MICROSOFT MVP · 2026</div>
      <div style="margin-top:6px;display:flex;justify-content:center;gap:16px;flex-wrap:wrap">
        {[
          { label: "Track 1", name: "ThoughtWorks",    color: green  },
          { label: "Track 2", name: "Microsoft Azure", color: blue   },
          { label: "Track 3", name: "Germany",         color: yellow },
        ].map(t => (
          <span style="font-size:12px">
            <span style={`color:${muted}`}>{t.label}: </span>
            <span style={`color:${t.color}`}>{t.name}</span>
          </span>
        ))}
      </div>
    </div>

  </div>
</Layout>

<script>
  // ── Tab switching ─────────────────────────────────────────────────────────
  const GREEN = '#00FFA3';
  const MUTED = '#5B6B7D';
  const tabBtns = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const panels  = document.querySelectorAll<HTMLElement>('.tab-panel');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.tab!;
      tabBtns.forEach(b => {
        b.style.color        = MUTED;
        b.style.borderBottom = '2px solid transparent';
        b.style.fontWeight   = '400';
      });
      btn.style.color        = GREEN;
      btn.style.borderBottom = `2px solid ${GREEN}`;
      btn.style.fontWeight   = '600';
      panels.forEach(p => (p.style.display = p.dataset.panel === target ? '' : 'none'));
    });
  });

  // ── Progress counters ─────────────────────────────────────────────────────
  const state: Record<string, number> = {};

  function refreshCounter(id: string) {
    const valEl = document.querySelector<HTMLElement>(`.counter-val[data-id="${id}"]`)!;
    const max   = parseInt(valEl.dataset.max!);
    const val   = state[id] ?? 0;
    const pct   = Math.round((val / max) * 100);
    valEl.textContent = String(val);
    (document.querySelector<HTMLElement>(`.counter-bar[data-id="${id}"]`))!.style.width = `${Math.min(pct, 100)}%`;
    (document.querySelector<HTMLElement>(`.counter-pct[data-id="${id}"]`))!.textContent = `${pct}% done`;
  }

  document.querySelectorAll<HTMLButtonElement>('.counter-inc').forEach(btn => {
    const id  = btn.dataset.id!;
    const max = parseInt(btn.dataset.max!);
    state[id] ??= 0;
    btn.addEventListener('click', () => { state[id] = Math.min(state[id] + 1, max); refreshCounter(id); });
  });

  document.querySelectorAll<HTMLButtonElement>('.counter-dec').forEach(btn => {
    const id = btn.dataset.id!;
    btn.addEventListener('click', () => { state[id] = Math.max((state[id] ?? 0) - 1, 0); refreshCounter(id); });
  });

  // ── Milestone checkboxes ──────────────────────────────────────────────────
  document.querySelectorAll<HTMLInputElement>('.milestone-cb').forEach(cb => {
    cb.addEventListener('change', () => {
      const span = cb.closest('label')!.querySelector('span') as HTMLElement;
      span.style.textDecoration = cb.checked ? 'line-through' : 'none';
      span.style.opacity        = cb.checked ? '0.4' : '1';
    });
  });
</script>
